{
  "name": "LiteEditor",
  "short_name": "LiteEditor",
  "description": "Edit Markdown and structured content in your GitHub repositories directly from the browser.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#111755",
  "theme_color": "#1a268f",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
