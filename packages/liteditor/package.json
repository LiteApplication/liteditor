{
  "name": "liteditor",
  "version": "0.3.0",
  "description": "Build-time content loader and config generator for websites edited with LiteEditor",
  "keywords": [
    "liteditor",
    "cms",
    "markdown",
    "frontmatter",
    "static-site",
    "vite",
    "astro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiteApplication/liteditor.git",
    "directory": "packages/liteditor"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "liteditor": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./remark": {
      "types": "./dist/remark.d.ts",
      "default": "./dist/remark.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "sync-schema": "node scripts/sync-schema.mjs",
    "sync-schema:check": "node scripts/sync-schema.mjs --check",
    "typecheck": "npm run sync-schema && tsc -p tsconfig.test.json",
    "build": "npm run sync-schema && tsc -p tsconfig.build.json",
    "test": "npm run sync-schema && node --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "jiti": "^2.4.2",
    "js-yaml": "^4.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
