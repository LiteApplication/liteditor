{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "content_path": {
      "type": "string"
    },
    "assets_path": {
      "type": "string"
    },
    "settings_file": {
      "type": "string"
    },
    "schema": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "frontmatter": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "carousels": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "schema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "frontmatter": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "label",
          "path"
        ]
      }
    },
    "elements": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "icon": {
            "type": "string",
            "maxLength": 32
          },
          "fields": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "display": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "images": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "label",
          "fields"
        ]
      }
    },
    "folders": {
      "type": "object",
      "properties": {
        "allow_create": {
          "type": "boolean"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "page_types": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "folders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allow_new_folders": {
            "type": "boolean"
          },
          "max_pages_per_folder": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "modes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "rich",
                "block"
              ]
            }
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "markdown_block": {
            "type": "boolean"
          },
          "frontmatter": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "label"
        ]
      }
    }
  },
  "required": [
    "content_path",
    "assets_path"
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "label": {
              "default": "",
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "short-text",
                "long-text",
                "boolean",
                "image",
                "link"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "default": "",
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "color"
            },
            "alpha": {
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "default": "",
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "selection"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "value",
                  "label"
                ]
              }
            }
          },
          "required": [
            "type",
            "options"
          ]
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "default": "",
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "list"
            },
            "itemSchema": {
              "$ref": "#/$defs/__schema0"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "itemSchema"
          ]
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "default": "",
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "object"
            },
            "fields": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "type",
            "fields"
          ]
        }
      ]
    }
  }
}
